    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- DAY 18 | STEP 3: RETRIEVE PENDING RETENTION INTERVENTIONS\n\nSELECT\n    i.Intervention_ID,\n    i.CustomerID,\n    i.Intervention_Type,\n    i.Priority,\n    i.Status,\n    c.Churn_Probability_Pct AS Risk_Score,\n    c.Risk_Category\nFROM nexus_customer_retention.retention_interventions AS i\nINNER JOIN nexus_customer_retention.customer_risk_scores AS c\n    ON i.CustomerID = c.CustomerID\nWHERE i.Status = 'Pending'\nORDER BY c.Churn_Probability_Pct DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "id": "50ef9816-c3e5-47cf-801a-1826a1376c9f",
